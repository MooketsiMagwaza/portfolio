---
import '@fontsource-variable/inter';
import '@/styles/global.css';
import '@/styles/desktop.css';
import '@/styles/windows.css';
import '@/styles/apps.css';
import { profile } from '@/data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.shortName} — ${profile.role}`,
  description = 'A full-stack engineer’s portfolio, presented as a desktop you can explore: a project gallery, notes on how I work, and a terminal.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const favicon = `${import.meta.env.BASE_URL}/favicon.svg`;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: Astro.site?.toString(),
  sameAs: [profile.github],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Gaborone',
    addressCountry: 'BW',
  },
  jobTitle: profile.role,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#2a2450" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <!-- Runs before paint so the desktop never flashes the wrong theme. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        let theme = null;
        let motion = null;
        try {
          theme = localStorage.getItem('mos-theme');
          motion = localStorage.getItem('mos-motion');
        } catch (error) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        root.dataset.theme = theme;
        if (motion === 'reduced') root.dataset.motion = 'reduced';
      })();
    </script>
    <title>{title}</title>
    <!--
      Concept credit: the idea of a portfolio inside a desktop OS is inspired by
      Loago Moremi's Windows XP-style portfolio, https://loag0.github.io/
      This site is an independent macOS take, built from scratch.
    -->
  </head>
  <body>
    <slot />
  </body>
</html>
