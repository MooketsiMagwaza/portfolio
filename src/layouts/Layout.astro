---
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Mooketsi Magwaza — Full-stack engineer',
  description = 'Full-stack engineer building useful products and the systems that keep them running.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const favicon = `${import.meta.env.BASE_URL}/favicon.svg`;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Mooketsi Vincent Magwaza',
  url: Astro.site?.toString(),
  sameAs: ['https://github.com/MooketsiMagwaza'],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Gaborone',
    addressCountry: 'BW',
  },
  jobTitle: 'Full-stack engineer',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f3f0e8" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
