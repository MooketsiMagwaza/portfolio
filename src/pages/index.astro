---
import Layout from '@/layouts/Layout.astro';
import { projects, supportingProjects } from '@/data/projects';
---

<Layout>
  <header class="site-header shell">
    <a class="brand" href="#top" aria-label="Mooketsi Magwaza, home">MM<span>.</span></a>
    <nav aria-label="Primary navigation">
      <a href="#work">Work</a>
      <a href="#approach">Approach</a>
      <a href="#contact">Contact</a>
    </nav>
    <a class="header-link" href="https://github.com/MooketsiMagwaza">GitHub ↗</a>
  </header>

  <main id="main">
    <section class="hero shell" id="top">
      <p class="eyebrow"><span class="status-dot"></span> Gaborone, Botswana · Open to thoughtful engineering work</p>
      <h1>I build useful products—and the systems that keep them running.</h1>
      <div class="hero-bottom">
        <p>
          I’m Mooketsi, a full-stack engineer working across product interfaces,
          backend services, data, reliability, and the documentation that lets a
          system outlive its first author.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#work">See selected work</a>
          <a class="button" href="mailto:mooketsimagwazajr@gmail.com">Start a conversation</a>
        </div>
      </div>
      <div class="signal-row" aria-label="Areas of practice">
        <span>Product engineering</span><span>Backend systems</span><span>Platform reliability</span><span>Open source</span>
      </div>
    </section>

    <section class="work-section shell" id="work" aria-labelledby="work-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Selected work / 01—03</p>
          <h2 id="work-title">Systems with evidence behind them.</h2>
        </div>
        <p>Each project separates what works today from what still needs to be proven. That honesty is part of the engineering.</p>
      </div>

      <div class="project-list">
        {projects.map((project, index) => (
          <article class="project-card">
            <div class="project-copy">
              <p class="project-number">0{index + 1}</p>
              <p class="project-kicker">{project.kicker}</p>
              <h3>{project.name}</h3>
              <p class="project-summary">{project.summary}</p>
              <div class="evidence-block">
                <p><strong>Verified</strong>{project.evidence}</p>
                <p><strong>Next</strong>{project.next}</p>
              </div>
              <ul class="tags" aria-label={`${project.name} technologies`}>
                {project.stack.map((item) => <li>{item}</li>)}
              </ul>
              <a class="text-link" href={project.repository}>Read the repository <span aria-hidden="true">↗</span></a>
            </div>
            <a class="project-visual" href={project.repository} aria-label={`View ${project.name} repository`}>
              <img src={`${import.meta.env.BASE_URL}/${project.image}`} alt={project.imageAlt} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="approach-section" id="approach" aria-labelledby="approach-title">
      <div class="shell approach-grid">
        <div>
          <p class="eyebrow">How I work</p>
          <h2 id="approach-title">Make the product clear. Make failure boring.</h2>
        </div>
        <ol class="principles">
          <li><span>01</span><div><h3>Start with the person</h3><p>Map the workflow and the decisions before choosing the architecture.</p></div></li>
          <li><span>02</span><div><h3>Design the boundaries</h3><p>Give data, services, permissions, and failure modes explicit owners.</p></div></li>
          <li><span>03</span><div><h3>Leave evidence</h3><p>Tests, traces, screenshots, runbooks, and honest status notes turn claims into something another engineer can verify.</p></div></li>
        </ol>
      </div>
    </section>

    <section class="supporting shell" aria-labelledby="support-title">
      <div class="section-heading compact">
        <div><p class="eyebrow">Also building</p><h2 id="support-title">Smaller signals, useful depth.</h2></div>
      </div>
      <div class="support-grid">
        {supportingProjects.map((project) => (
          <a class="support-card" href={project.href}>
            <h3>{project.name}</h3>
            <p>{project.description}</p>
            <span>View project ↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="contact-section shell" id="contact" aria-labelledby="contact-title">
      <p class="eyebrow">Contact</p>
      <h2 id="contact-title">Have a difficult, useful thing to build?</h2>
      <div class="contact-bottom">
        <p>I’m interested in backend, full-stack, and platform work where product judgment matters as much as implementation.</p>
        <a class="button button-light" href="mailto:mooketsimagwazajr@gmail.com">mooketsimagwazajr@gmail.com</a>
      </div>
    </section>
  </main>

  <footer class="site-footer shell">
    <p>© {new Date().getFullYear()} Mooketsi Vincent Magwaza</p>
    <div><a href="https://github.com/MooketsiMagwaza">GitHub</a><a href="mailto:mooketsimagwazajr@gmail.com">Email</a></div>
  </footer>
</Layout>
