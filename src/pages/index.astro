---
import Layout from '@/layouts/Layout.astro';
import Sprites from '@/components/sprites/Sprites.astro';
import Wallpaper from '@/components/Wallpaper.astro';
import MenuBar from '@/components/MenuBar.astro';
import DesktopIcons from '@/components/DesktopIcons.astro';
import Dock from '@/components/Dock.astro';
import Spotlight from '@/components/Spotlight.astro';
import QuickLook from '@/components/QuickLook.astro';
import ControlCenter from '@/components/ControlCenter.astro';
import FinderApp from '@/components/apps/FinderApp.astro';
import ContactsApp from '@/components/apps/ContactsApp.astro';
import NotesApp from '@/components/apps/NotesApp.astro';
import TerminalApp from '@/components/apps/TerminalApp.astro';
import MailApp from '@/components/apps/MailApp.astro';
import AboutApp from '@/components/apps/AboutApp.astro';
import { inspiration, profile } from '@/data/site';
---

<Layout>
  <Sprites />
  <a class="skip-link" href="#main">Skip to the projects</a>
  <h1 class="sr-only">{profile.shortName} — {profile.role}. {profile.headline}</h1>

  <div class="desktop" id="desktop">
    <Wallpaper />
    <MenuBar />
    <DesktopIcons />

    <main class="windows" id="main" data-windows>
      <FinderApp />
      <ContactsApp />
      <NotesApp />
      <TerminalApp />
      <MailApp />
      <AboutApp />
    </main>

    <Dock />
    <ControlCenter />
    <Spotlight />
    <QuickLook />
    <div class="notifications" data-notifications aria-live="polite"></div>

    <p class="credit">
      Inspired by <a href={inspiration.url} target="_blank" rel="noopener noreferrer">{inspiration.name}’s portfolio</a>
    </p>
  </div>

  <noscript>
    <style>
      .menubar, .dock, .desktop-icons, .wallpaper, .credit, .traffic, .resize { display: none !important; }
      .desktop { position: static; overflow: visible; background: #ececf1; color: #1d1d1f; padding: 24px 16px 48px; }
      .windows { position: static; display: grid; gap: 24px; max-width: 900px; margin: 0 auto; }
      .window { position: relative !important; display: flex !important; inset: auto !important; left: auto !important; top: auto !important; width: auto !important; height: auto !important; max-height: none !important; }
      .window--terminal, .window--mail { display: none !important; }
    </style>
  </noscript>
</Layout>

<script>
  import '@/scripts/desktop';
</script>
