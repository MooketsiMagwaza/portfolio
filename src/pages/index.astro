---
import Layout from '@/layouts/Layout.astro';
import IPhone from '@/components/IPhone.astro';
import MacWindow from '@/components/MacWindow.astro';
import { projects, supportingProjects } from '@/data/projects';

const [stocklink, tsela, obsidian] = projects;
const images = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/images`;
---

<Layout>
  <header class="global-nav">
    <nav class="nav-inner" aria-label="Primary navigation">
      <a class="wordmark" href="#top" aria-label="Mooketsi Magwaza, home">M</a>
      <div class="nav-links">
        <a href="#work">Work</a>
        <a href="#about">Approach</a>
        <a href="https://github.com/MooketsiMagwaza">GitHub</a>
      </div>
      <a class="nav-cta" href="mailto:mooketsimagwazajr@gmail.com">Contact</a>
    </nav>
  </header>

  <main id="main">
    <section class="hero" id="top">
      <div class="hero-content">
        <p class="availability"><span></span> Full-stack engineer · Gaborone, Botswana</p>
        <h1>I make complicated software <span>feel simple.</span></h1>
        <p class="hero-copy">
          I’m Mooketsi. I turn messy, real-world problems into tools people can
          actually use—from the screen they tap to the systems working behind it.
        </p>
        <div class="actions">
          <a class="button primary" href="#work">Explore my work</a>
          <a class="button link-button" href="mailto:mooketsimagwazajr@gmail.com">Get in touch <span>›</span></a>
        </div>
      </div>
      <div class="glass-stage" aria-label="Selected project previews">
        <span class="stage-glow stage-glow-blue" aria-hidden="true"></span>
        <span class="stage-glow stage-glow-pink" aria-hidden="true"></span>
        <a class="glass-card glass-card-main" href={stocklink.repository} aria-label="View StockLink on GitHub">
          <span class="glass-shine" aria-hidden="true"></span>
          <div class="glass-card-head"><span>01</span><strong>StockLink</strong><small>Wholesale, end to end</small></div>
          <div class="glass-card-body">
            <p>Warehouses, shops and drivers in one place.</p>
            <div class="glass-tags">{stocklink.stack.slice(0, 3).map((item) => <span>{item}</span>)}</div>
          </div>
        </a>
        <a class="glass-card glass-card-left" href={tsela.repository} aria-label="View Tsela on GitHub">
          <span class="glass-shine" aria-hidden="true"></span>
          <div class="glass-card-head"><span>02</span><strong>Tsela</strong><small>Transit, made clearer</small></div>
          <div class="glass-card-body">
            <p>Routes, stops, and local knowledge in one calm platform.</p>
            <div class="glass-tags">{tsela.stack.slice(0, 2).map((item) => <span>{item}</span>)}</div>
          </div>
        </a>
        <a class="glass-card glass-card-right" href={obsidian.repository} aria-label="View Obsidian Sync for iOS on GitHub">
          <span class="glass-shine" aria-hidden="true"></span>
          <div class="glass-card-head"><span>03</span><strong>Obsidian Sync</strong><small>Native, private sync</small></div>
          <div class="glass-card-body">
            <p>Private notes moving between your own devices.</p>
            <div class="glass-tags">{obsidian.stack.slice(0, 2).map((item) => <span>{item}</span>)}</div>
          </div>
        </a>
      </div>
    </section>

    <section class="intro-strip" aria-label="Engineering focus">
      <p>Product thinking</p><span>+</span><p>Systems engineering</p><span>+</span><p>Operational clarity</p>
    </section>

    <section class="work" id="work" aria-labelledby="work-title">
      <header class="section-intro">
        <p class="section-label">Selected work</p>
        <h2 id="work-title">Things I’ve been building.<br /><span>Made for real people.</span></h2>
      </header>

      <article class="showcase showcase-blue" id="stocklink">
        <div class="showcase-copy">
          <p class="project-label">01 · Wholesale logistics platform</p>
          <h3>{stocklink.name}</h3>
          <p>Small shops buy from lots of different warehouses, and the hard part is getting it all to their door. StockLink puts the order, the payment and the delivery in one place, right down to the code a driver needs before handing a parcel over.</p>
          <div class="actions centered">
            <a class="button primary" href={stocklink.repository}>View the repository</a>
            <a class="button link-button" href="#stocklink-proof">What’s verified <span>›</span></a>
          </div>
        </div>

        <div class="device-stage" aria-label="StockLink on a Mac and on a phone">
          <IPhone
            class="device-phone device-phone-left"
            src={`${images}/stocklink/driver-pickup-screen-dark.png`}
            alt="StockLink driver app in dark mode: collecting a parcel from the warehouse with its pickup code"
            statusBg="#161617"
            width={390}
            height={820}
            loading="eager"
          />
          <MacWindow
            class="device-mac"
            src={`${images}/stocklink/store-order-dark.png`}
            alt="StockLink retail store view in dark mode: an order in transit, with its delivery code, QR code, and live position"
            title="StockLink — Order"
            theme="dark"
            width={1280}
            height={870}
            loading="eager"
          />
          <IPhone
            class="device-phone device-phone-right"
            src={`${images}/stocklink/driver-road-screen-dark.png`}
            alt="StockLink driver app in dark mode: on the road, with the handover form and position sharing"
            statusBg="#161617"
            width={390}
            height={820}
            loading="eager"
          />
        </div>

        <figure class="tracking-stage">
          <MacWindow
            src={`${images}/stocklink/public-tracking-dark.png`}
            alt="StockLink public tracking page in dark mode: a parcel’s journey and rounded position, with no account needed"
            title="Track a parcel"
            theme="dark"
            width={620}
            height={610}
          />
          <figcaption><strong>No account needed.</strong> Anyone with the tracking link can see where a parcel is, to within about 100 metres. They never see names, addresses or what’s inside.</figcaption>
        </figure>

        <p class="stage-note">Dark mode, from StockLink’s sample-data preview. The shops, orders and numbers are made up, and every page says so.</p>

        <div class="proof" id="stocklink-proof">
          <div><span>Built with</span><p>{stocklink.stack.join(' · ')}</p></div>
          <div><span>Verified today</span><p>{stocklink.evidence}</p></div>
          <div><span>Next milestone</span><p>{stocklink.next}</p></div>
        </div>
      </article>

      <div class="showcase-grid">
        <article class="showcase showcase-light compact-showcase">
          <div class="showcase-copy">
            <p class="project-label">02 · Public transport platform</p>
            <h3>{tsela.name}</h3>
            <p>Getting around Gaborone shouldn’t require insider knowledge. Tsela brings routes, stops, directions, and community knowledge into one calm place.</p>
            <a class="button link-button" href={tsela.repository}>View project <span>›</span></a>
          </div>
          <div class="compact-stage" aria-label="The Tsela rider app">
            <MacWindow
              class="compact-stage-back"
              src={`${images}/tsela/rider-routes.jpg`}
              alt="Tsela rider app: every mapped route in Gaborone, with search"
              title="Tsela — Explore every route"
              theme="light"
              width={1440}
              height={960}
            />
            <MacWindow
              class="compact-stage-front"
              src={`${images}/tsela/rider-live-route.jpg`}
              alt="Tsela rider app: live trip guidance for Tlokweng Route 1, with a stop picker"
              title="Live trip guidance"
              theme="light"
              width={1440}
              height={960}
            />
          </div>
          <div class="project-facts" aria-label="Tsela project details">
            <div><span>Built with</span><p>{tsela.stack.join(' · ')}</p></div>
            <div><span>Verified today</span><p>{tsela.evidence}</p></div>
          </div>
        </article>

        <article class="showcase showcase-dark compact-showcase">
          <div class="showcase-copy">
            <p class="project-label">03 · Native synchronization</p>
            <h3>{obsidian.name}</h3>
            <p>I wanted notes to move between my devices without handing them to another cloud. This is the native iPad experiment that came from that.</p>
            <a class="button link-button light-link" href={obsidian.repository}>View project <span>›</span></a>
          </div>
          <div class="project-facts project-facts-dark" aria-label="Obsidian Sync project details">
            <div><span>Built with</span><p>{obsidian.stack.join(' · ')}</p></div>
            <div><span>Verified</span><p>{obsidian.evidence}</p></div>
          </div>
        </article>
      </div>
    </section>

    <section class="approach" id="about" aria-labelledby="approach-title">
      <div class="approach-heading">
        <p class="section-label">How I work</p>
        <h2 id="approach-title">Good software starts<br /><span>with paying attention.</span></h2>
      </div>
      <div class="principles">
        <article><p class="principle-number">01</p><h3>Listen before building.</h3><p>The best technical decision starts with understanding what someone is actually trying to get done.</p></article>
        <article><p class="principle-number">02</p><h3>Make the edges obvious.</h3><p>Clear ownership for data, services, permissions, and failures keeps a growing system understandable.</p></article>
        <article><p class="principle-number">03</p><h3>Show the receipts.</h3><p>Tests, traces, screenshots, and runbooks make the work easier to trust—and easier for the next person to continue.</p></article>
      </div>
    </section>

    <section class="more-work" aria-labelledby="more-title">
      <header>
        <p class="section-label">More work</p>
        <h2 id="more-title">Different surfaces.<br /><span>The same care.</span></h2>
      </header>
      <div class="more-grid">
        {supportingProjects.map((project, index) => (
          <a class={`more-card more-card-${index + 1}`} href={project.href}>
            <span class="card-index">0{index + 4}</span>
            <div><h3>{project.name}</h3><p>{project.description}</p></div>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="contact" id="contact">
      <p class="section-label">Let’s build something useful</p>
      <h2>Got something useful<br />in mind?</h2>
      <p>I’m always happy to talk about a thoughtful product, a stubborn systems problem, or work that genuinely helps people.</p>
      <a class="button primary" href="mailto:mooketsimagwazajr@gmail.com">Start a conversation</a>
    </section>
  </main>

  <footer>
    <p>© {new Date().getFullYear()} Mooketsi Vincent Magwaza</p>
    <div><span>Gaborone, Botswana</span><a href="https://github.com/MooketsiMagwaza">GitHub</a><a href="mailto:mooketsimagwazajr@gmail.com">Email</a></div>
  </footer>
</Layout>
