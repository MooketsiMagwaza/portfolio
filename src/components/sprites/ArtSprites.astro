---
/**
 * Cover illustrations for the project gallery (640×400).
 * They are stylised diagrams of what each project does, not screenshots.
 */
---

<defs>
  <linearGradient id="art-tsela-bg" x1="0" y1="0" x2="1" y2="1">
    <stop offset="0" stop-color="#081936"></stop>
    <stop offset="1" stop-color="#0e4f86"></stop>
  </linearGradient>
  <radialGradient id="art-tsela-glow" cx=".82" cy=".14" r=".65">
    <stop offset="0" stop-color="#2dd4bf" stop-opacity=".5"></stop>
    <stop offset="1" stop-color="#2dd4bf" stop-opacity="0"></stop>
  </radialGradient>

  <linearGradient id="art-stock-bg" x1="0" y1="0" x2="1" y2="1">
    <stop offset="0" stop-color="#1d1106"></stop>
    <stop offset="1" stop-color="#8b4a0c"></stop>
  </linearGradient>
  <radialGradient id="art-stock-glow" cx=".18" cy=".1" r=".7">
    <stop offset="0" stop-color="#ffb020" stop-opacity=".5"></stop>
    <stop offset="1" stop-color="#ffb020" stop-opacity="0"></stop>
  </radialGradient>

  <linearGradient id="art-obs-bg" x1="0" y1="0" x2="1" y2="1">
    <stop offset="0" stop-color="#10081f"></stop>
    <stop offset="1" stop-color="#3b1d72"></stop>
  </linearGradient>
  <radialGradient id="art-obs-glow" cx=".5" cy=".46" r=".5">
    <stop offset="0" stop-color="#a78bfa" stop-opacity=".55"></stop>
    <stop offset="1" stop-color="#a78bfa" stop-opacity="0"></stop>
  </radialGradient>
  <linearGradient id="art-obs-a" x1="0" y1="0" x2="1" y2="1">
    <stop offset="0" stop-color="#7c5cf0"></stop>
    <stop offset="1" stop-color="#26124f"></stop>
  </linearGradient>
  <linearGradient id="art-obs-b" x1="1" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="#3a2478"></stop>
    <stop offset="1" stop-color="#0c0618"></stop>
  </linearGradient>
  <linearGradient id="art-obs-c" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="#c4b5fd"></stop>
    <stop offset="1" stop-color="#6d4bd8"></stop>
  </linearGradient>

  <linearGradient id="art-docs-bg" x1="0" y1="0" x2="1" y2="1">
    <stop offset="0" stop-color="#04201a"></stop>
    <stop offset="1" stop-color="#0d6a4b"></stop>
  </linearGradient>
  <radialGradient id="art-docs-glow" cx=".85" cy=".1" r=".6">
    <stop offset="0" stop-color="#5eead4" stop-opacity=".45"></stop>
    <stop offset="1" stop-color="#5eead4" stop-opacity="0"></stop>
  </radialGradient>

  <linearGradient id="art-hid-bg" x1="0" y1="0" x2="1" y2="1">
    <stop offset="0" stop-color="#031820"></stop>
    <stop offset="1" stop-color="#0b6f86"></stop>
  </linearGradient>
  <radialGradient id="art-hid-glow" cx=".5" cy=".5" r=".55">
    <stop offset="0" stop-color="#22d3ee" stop-opacity=".35"></stop>
    <stop offset="1" stop-color="#22d3ee" stop-opacity="0"></stop>
  </radialGradient>
</defs>

<!-- Tsela: transit lines over a city grid -->
<symbol id="art-tsela" viewBox="0 0 640 400">
  <rect width="640" height="400" fill="url(#art-tsela-bg)"></rect>
  <rect width="640" height="400" fill="url(#art-tsela-glow)"></rect>
  <g stroke="#fff" stroke-opacity=".07" stroke-width="2" fill="none">
    <path d="M0 80H640M0 160H640M0 240H640M0 320H640M80 0V400M180 0V400M290 0V400M400 0V400M510 0V400"></path>
    <path d="M-30 372 310 -30M150 430 610 -20"></path>
  </g>
  <path d="M0 292C96 258 158 338 268 304S436 252 528 302 640 332 640 332V400H0Z" fill="#0a6a86" opacity=".38"></path>
  <rect x="424" y="84" width="84" height="56" rx="14" fill="#19a37a" opacity=".3"></rect>
  <rect x="96" y="176" width="66" height="48" rx="12" fill="#19a37a" opacity=".22"></rect>
  <g fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="9">
    <path d="M40 320H180V240H400V150H604" stroke="#2dd4bf"></path>
    <path d="M60 56V160H290V330H430" stroke="#ffb020"></path>
    <path d="M590 50H510V240H604" stroke="#ff6b9a"></path>
  </g>
  <g fill="#0b1f3f" stroke-width="4">
    <circle cx="40" cy="320" r="7" stroke="#2dd4bf"></circle>
    <circle cx="180" cy="280" r="7" stroke="#2dd4bf"></circle>
    <circle cx="400" cy="195" r="7" stroke="#2dd4bf"></circle>
    <circle cx="604" cy="150" r="7" stroke="#2dd4bf"></circle>
    <circle cx="60" cy="56" r="7" stroke="#ffb020"></circle>
    <circle cx="60" cy="110" r="7" stroke="#ffb020"></circle>
    <circle cx="180" cy="160" r="7" stroke="#ffb020"></circle>
    <circle cx="290" cy="290" r="7" stroke="#ffb020"></circle>
    <circle cx="430" cy="330" r="7" stroke="#ffb020"></circle>
    <circle cx="590" cy="50" r="7" stroke="#ff6b9a"></circle>
    <circle cx="510" cy="100" r="7" stroke="#ff6b9a"></circle>
    <circle cx="604" cy="240" r="7" stroke="#ff6b9a"></circle>
  </g>
  <g fill="#fff" stroke="#0b1f3f" stroke-width="4">
    <circle cx="290" cy="240" r="11"></circle>
    <circle cx="510" cy="150" r="11"></circle>
    <circle cx="290" cy="160" r="0"></circle>
  </g>
  <!-- rider location -->
  <circle cx="180" cy="320" r="22" fill="#38bdf8" opacity=".22"></circle>
  <circle cx="180" cy="320" r="10" fill="#38bdf8" stroke="#fff" stroke-width="4"></circle>
  <!-- trip card -->
  <g transform="translate(446 236)">
    <rect width="170" height="84" rx="16" fill="#fff" fill-opacity=".14" stroke="#fff" stroke-opacity=".3"></rect>
    <circle cx="26" cy="28" r="10" fill="#2dd4bf"></circle>
    <rect x="46" y="20" width="84" height="8" rx="4" fill="#fff" fill-opacity=".85"></rect>
    <rect x="46" y="36" width="56" height="6" rx="3" fill="#fff" fill-opacity=".45"></rect>
    <rect x="18" y="58" width="134" height="10" rx="5" fill="#fff" fill-opacity=".22"></rect>
    <rect x="18" y="58" width="82" height="10" rx="5" fill="#2dd4bf"></rect>
  </g>
</symbol>

