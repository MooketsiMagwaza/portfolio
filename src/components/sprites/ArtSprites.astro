<!-- Obsidian Sync: a laptop and an iPad exchanging notes through a crystal -->
<symbol id="art-obsidian" viewBox="0 0 640 400">
  <rect width="640" height="400" fill="url(#art-obs-bg)"></rect>
  <rect width="640" height="400" fill="url(#art-obs-glow)"></rect>
  <g fill="#fff">
    <circle cx="70" cy="60" r="1.6" opacity=".6"></circle><circle cx="180" cy="38" r="1.2" opacity=".5"></circle>
    <circle cx="560" cy="70" r="1.6" opacity=".55"></circle><circle cx="470" cy="34" r="1.2" opacity=".5"></circle>
    <circle cx="600" cy="330" r="1.4" opacity=".4"></circle><circle cx="40" cy="340" r="1.4" opacity=".4"></circle>
  </g>
  <!-- laptop -->
  <g>
    <rect x="46" y="146" width="150" height="98" rx="10" fill="#fff" fill-opacity=".08" stroke="#fff" stroke-opacity=".65" stroke-width="3"></rect>
    <path d="M28 258h186l-10 14H38z" fill="#fff" fill-opacity=".22" stroke="#fff" stroke-opacity=".55" stroke-width="3" stroke-linejoin="round"></path>
    <rect x="64" y="166" width="70" height="8" rx="4" fill="#fff" fill-opacity=".7"></rect>
    <rect x="64" y="184" width="110" height="6" rx="3" fill="#fff" fill-opacity=".35"></rect>
    <rect x="64" y="198" width="92" height="6" rx="3" fill="#fff" fill-opacity=".35"></rect>
    <rect x="64" y="212" width="60" height="6" rx="3" fill="#fff" fill-opacity=".35"></rect>
  </g>
  <!-- iPad -->
  <g>
    <rect x="444" y="132" width="158" height="118" rx="16" fill="#fff" fill-opacity=".08" stroke="#fff" stroke-opacity=".65" stroke-width="3"></rect>
    <circle cx="452" cy="191" r="2.4" fill="#fff" fill-opacity=".6"></circle>
    <rect x="468" y="152" width="70" height="8" rx="4" fill="#fff" fill-opacity=".7"></rect>
    <rect x="468" y="170" width="110" height="6" rx="3" fill="#fff" fill-opacity=".35"></rect>
    <rect x="468" y="184" width="92" height="6" rx="3" fill="#fff" fill-opacity=".35"></rect>
    <rect x="468" y="198" width="100" height="6" rx="3" fill="#fff" fill-opacity=".35"></rect>
    <rect x="468" y="212" width="60" height="6" rx="3" fill="#fff" fill-opacity=".35"></rect>
  </g>
  <!-- sync links -->
  <g fill="none" stroke="#c4b5fd" stroke-width="3" stroke-linecap="round" stroke-dasharray="2 9" stroke-opacity=".9">
    <path d="M204 192C240 168 258 168 284 178"></path>
    <path d="M204 222C240 244 258 244 284 234"></path>
    <path d="M436 192C400 168 382 168 356 178"></path>
    <path d="M436 222C400 244 382 244 356 234"></path>
  </g>
  <g fill="#c4b5fd">
    <path d="M280 172l10 5-10 6z"></path>
    <path d="M288 228l-10 5 10 6z"></path>
    <path d="M360 172l-10 5 10 6z"></path>
    <path d="M352 228l10 5-10 6z"></path>
  </g>
  <!-- the crystal -->
  <g stroke-linejoin="round">
    <path d="M320 70 378 140 350 300 320 330 290 300 262 140z" fill="url(#art-obs-b)" stroke="#c4b5fd" stroke-opacity=".6" stroke-width="2"></path>
    <path d="M320 70 378 140 320 178z" fill="url(#art-obs-c)" opacity=".95"></path>
    <path d="M320 70 262 140 320 178z" fill="url(#art-obs-a)"></path>
    <path d="M262 140 320 178 290 300z" fill="url(#art-obs-a)" opacity=".85"></path>
    <path d="M378 140 320 178 350 300z" fill="url(#art-obs-b)"></path>
    <path d="M320 178 290 300 320 330 350 300z" fill="#1a0d38" opacity=".9"></path>
    <path d="M312 92 296 122" stroke="#fff" stroke-opacity=".7" stroke-width="3" stroke-linecap="round" fill="none"></path>
  </g>
  <ellipse cx="320" cy="362" rx="80" ry="10" fill="#000" opacity=".28"></ellipse>
</symbol>

