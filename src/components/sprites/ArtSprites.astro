  </g>
  <rect x="236" y="40" width="168" height="46" rx="14" fill="#fff" fill-opacity=".14" stroke="#fff" stroke-opacity=".4"></rect>
  <g fill="#fff" fill-opacity=".85"><circle cx="270" cy="63" r="5"></circle><rect x="288" y="59" width="86" height="8" rx="4"></rect></g>
