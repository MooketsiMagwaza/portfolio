---
interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;
---

<svg class:list={['app-icon', className]} width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false"><use href={`#app-${name}`}></use></svg>
