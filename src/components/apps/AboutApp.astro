---
import Window from '@/components/Window.astro';
import AppIcon from '@/components/AppIcon.astro';
import Icon from '@/components/Icon.astro';
import { asset, projects } from '@/data/projects';
import { inspiration, profile, stackGroups } from '@/data/site';

const tabs = [
  { id: 'overview', label: 'Overview' },
  { id: 'stack', label: 'Technical toolkit' },
  { id: 'credits', label: 'Credits' },
];

const cvUrl = asset('Mooketsi-Magwaza-CV.pdf');
---

<Window id="about" label="Mooketsi Magwaza profile and CV" w={680} h={640} fixed>
  <div class="about" data-about>
    <header class="titlebar" data-drag>
      <span class="titlebar__title">Mooketsi Magwaza</span>
    </header>
    <div class="about__tabs segmented" role="tablist" aria-label="About sections" data-nodrag>
      {
        tabs.map((tab, index) => (
          <button type="button" role="tab" id={`about-tab-${tab.id}`} aria-controls={`about-${tab.id}`} aria-selected={index === 0 ? 'true' : 'false'} data-about-tab={tab.id}>
            {tab.label}
          </button>
        ))
      }
    </div>

    <div class="about__panels">
      <section class="about__panel" id="about-overview" role="tabpanel" aria-labelledby="about-tab-overview" data-about-panel="overview">
        <div class="about__hero">
          <AppIcon name="logo" size={92} class="about__logo" />
          <div>
            <h2>{profile.shortName}</h2>
            <p>{profile.role} · {profile.location}</p>
          </div>
        </div>
        <section class="about__section" aria-labelledby="about-summary-title">
          <h3 id="about-summary-title">Quick summary</h3>
          <p class="about__summary">{profile.intro}</p>
        </section>
        <div class="about__actions">
          <a class="btn btn--primary" href={cvUrl} target="_blank" rel="noopener noreferrer"><Icon name="note" size={14} /> Open CV (PDF)</a>
          <button class="btn" type="button" data-open-app="finder"><Icon name="folder" size={14} /> View projects</button>
          <a class="btn" href={`mailto:${profile.email}`}><Icon name="mail" size={14} /> Email</a>
        </div>
        <section class="about__section" aria-labelledby="about-toolkit-title">
          <h3 id="about-toolkit-title">Toolkit at a glance</h3>
          <dl class="specs">
            <div><dt>Product UI</dt><dd>TypeScript · React · Next.js · Responsive UI</dd></div>
            <div><dt>Backend & data</dt><dd>Rust · Python · PostgreSQL · PostGIS · Redis</dd></div>
            <div><dt>Delivery</dt><dd>Docker · GitHub Actions · OpenTelemetry · Grafana</dd></div>
            <div><dt>Native & maps</dt><dd>Tauri · Windows APIs · MapLibre · PMTiles</dd></div>
          </dl>
        </section>
        <section class="about__section" aria-labelledby="about-work-title">
          <h3 id="about-work-title">Selected work</h3>
          <p class="about__selected"><strong>{projects.length} documented products:</strong> Tagwise, Kori, Opaline, and University CS Docs.</p>
        </section>
      </section>

      <section class="about__panel" id="about-stack" role="tabpanel" aria-labelledby="about-tab-stack" data-about-panel="stack" hidden>
        <p class="about__lede">Grouped for quick scanning.</p>
        <div class="stack-groups">
          {
            stackGroups.map((group) => (
              <div class="stack-group">
                <h3>{group.label}</h3>
                <ul class="pills">{group.items.map((item) => <li>{item}</li>)}</ul>
              </div>
            ))
          }
        </div>
      </section>

      <section class="about__panel" id="about-credits" role="tabpanel" aria-labelledby="about-tab-credits" data-about-panel="credits" hidden>
        <div class="credit-card">
          <h3>Inspired by {inspiration.name}</h3>
          <p>
            A portfolio that lives inside a desktop operating system is an idea I first saw on{' '}
            <a href={inspiration.url} target="_blank" rel="noopener noreferrer">{inspiration.name}’s site <Icon name="external" size={12} /></a>,{' '}
            {inspiration.description}. This is a macOS take on it. Thank you for the spark.
          </p>
        </div>
        <ul class="credit-list">
          <li>The app icons are drawn from scratch for this site. The project images are captures of the projects themselves, with a Mac window or an iPhone drawn around them; where the data in a capture is invented, the caption says so.</li>
          <li>Set in Inter (SIL Open Font License) via Fontsource, with system fonts on Apple devices.</li>
          <li>Built with Astro and TypeScript. No trackers, no cookies.</li>
          <li>macOS, Finder, and other Apple names are trademarks of Apple Inc. This is an independent tribute, not affiliated with Apple.</li>
        </ul>
        <a class="btn" href={profile.sourceRepo} target="_blank" rel="noopener noreferrer"><Icon name="code" size={14} /> View source <Icon name="external" size={12} /></a>
      </section>
    </div>
  </div>
</Window>
