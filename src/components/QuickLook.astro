---
import Art from '@/components/Art.astro';
import Icon from '@/components/Icon.astro';
import { projects, tagLabels } from '@/data/projects';
---

<div class="quicklook" data-quicklook hidden>
  <div class="quicklook__scrim" data-quicklook-close></div>
  <article class="quicklook__panel" role="dialog" aria-modal="true" aria-label="Quick Look" tabindex="-1">
    <header class="quicklook__bar">
      <button class="quicklook__close" type="button" aria-label="Close Quick Look" data-quicklook-close>
        <Icon name="close" size={12} />
      </button>
      <strong data-ql-title></strong>
      <a class="btn" data-ql-open target="_blank" rel="noopener noreferrer">Open on GitHub <Icon name="external" size={12} /></a>
    </header>
    {
      projects.map((project) => (
        <div class="quicklook__page" data-ql={project.slug} hidden>
          <Art name={project.art} label={`Illustration for ${project.name}`} class="quicklook__art" />
          <div class="quicklook__body">
            <h2>{project.name}</h2>
            <p class="quicklook__kicker">{project.kicker}</p>
            <p>{project.summary}</p>
            <p class="pills">{project.stack.map((item) => <span>{item}</span>)}</p>
            <p class="quicklook__tags">
              {project.tags.map((tag) => <span><i class={`tag-dot tag-dot--${tag}`}></i>{tagLabels[tag]}</span>)}
            </p>
          </div>
        </div>
      ))
    }
  </article>
</div>
