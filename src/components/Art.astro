---
interface Props {
  name: string;
  label: string;
  class?: string;
}

const { name, label, class: className } = Astro.props;
---

<svg class:list={['art', className]} viewBox="0 0 640 400" preserveAspectRatio="xMidYMid slice" role="img" aria-label={label}><use href={`#art-${name}`}></use></svg>
