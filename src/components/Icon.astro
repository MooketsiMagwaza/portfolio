---
interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 16, class: className } = Astro.props;
---

<svg class:list={['glyph', className]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href={`#g-${name}`}></use></svg>
